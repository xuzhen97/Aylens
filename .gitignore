node_modules/
# 构建产物目录整体忽略；dist/AylensBridge.zip 是 VCPToolBox 商店的安装载荷，必须入库。
# 必须写成 dist/* 而不是 dist/——目录级 ignore 会让后面的白名单失效（git 根本不会进入该目录）。
dist/*
!dist/AylensBridge.zip
# 各 workspace 包的构建产物（tsc/esbuild 输出，可重新构建，不入库）
packages/*/dist/
release/
.tmp/
apps/admin/dist/
coverage/
.env
.env.*
*.log
.DS_Store

# Runner 侧 persistent Chrome 用户数据目录
.profiles/

# 本地 SQLite 数据目录(Gateway/Runner 各自独立)
.data/

# Playwright MCP captures
.playwright-mcp/

# Admin web workspace build artifacts
apps/admin/dist/
