{
  "name": "aylens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:runner": "tsx watch src/runner/index.ts",
    "start": "node dist/src/index.js",
    "start:runner": "node dist/src/runner/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:generic-browser": "tsx scripts/smoke-generic-browser.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "playwright-core": "^1.63.0",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
