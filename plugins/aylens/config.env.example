# Aylens Gateway 基础地址（Gateway 是控制面，默认监听 3000）
AYLENS_BASE_URL=http://127.0.0.1:3000

# Aylens Gateway 的 Bearer API Key（对应 config/aylens.yaml 的 auth.apiKey）
AYLENS_API_KEY=change-me

# (可选) 请求超时时间（毫秒），默认 120000
# url-fetch 的浏览器兜底 + x-search 的登录态检查都可能偏慢，不要设得过小
REQUEST_TIMEOUT_MS=120000

# (可选) 是否允许 LoginProviderAuth 命令，默认 false。
# 该命令会在 Runner 上拉起一个**可见的** Chrome 并打开登录页，可能打断同 Profile 的进行中任务。
# 只有在确实需要远程触发人工登录时才打开。
AYLENS_ALLOW_AUTH_LOGIN=false
